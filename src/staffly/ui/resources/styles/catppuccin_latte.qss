/* ═══════════════════════════════════════════════════════════════════════════
   CATPPUCCIN LATTE LIGHT THEME
   Modern light UI with Mauve accent
   
   Color Palette:
   - Base (background):  #eff1f5
   - Surface:            #e6e9ef  
   - Surface variant:    #dce0e8
   - Borders:            #bcc0cc
   - Primary text:       #4c4f69
   - Secondary text:     #6c6f85
   - Accent (Mauve):     #8839ef
   - Success:            #40a02b
   - Danger:             #d20f39
   - Selection:          #1e66f5
   ═══════════════════════════════════════════════════════════════════════════ */

/* ───────────────────────────────────────────────────────────────────────────
   GLOBAL BASE STYLES
   ─────────────────────────────────────────────────────────────────────────── */

* {
    font-family: 'Segoe UI', 'Inter', 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif;
}

QWidget {
    background-color: #eff1f5;
    color: #4c4f69;
    font-family: 'Segoe UI', 'Inter', 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #eff1f5;
}

/* ───────────────────────────────────────────────────────────────────────────
   CARD / PANEL CONTAINERS (QFrame, QGroupBox)
   ─────────────────────────────────────────────────────────────────────────── */

QFrame[frameShape="StyledPanel"], 
QFrame.card,
QWidget#card,
QFrame#card {
    background-color: #e6e9ef;
    border: 1px solid #bcc0cc;
    border-radius: 8px;
}

/* Badge label style */
QLabel#badge {
    background-color: #ccd0da;
    color: #8839ef;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
}

/* Status label style */
QLabel#statusLabel {
    color: #7c7f93;
    font-size: 13px;
    padding: 8px 4px;
    background-color: transparent;
    border: none;
}

/* Bold status label */
QLabel#statusLabelBold {
    color: #4c4f69;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 4px;
    background-color: transparent;
    border: none;
}

/* Success status label */
QLabel#statusLabelSuccess {
    color: #40a02b;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 4px;
    background-color: transparent;
    border: none;
}

/* Card header label */
QLabel#cardHeader {
    font-size: 15px;
    font-weight: 600;
    color: #4c4f69;
    padding: 16px 20px;
    border-bottom: 1px solid #bcc0cc;
    background: transparent;
}

/* Gross input special styling */
QLineEdit#grossInput {
    font-size: 18px;
    font-weight: bold;
    padding: 8px;
    border: 2px solid #40a02b;
    border-radius: 4px;
}

/* Legend badges */
QLabel#legendBadgeBlue {
    color: #ffffff; 
    background-color: #1e66f5; 
    padding: 4px 10px; 
    border-radius: 12px;
    font-size: 11px;
    font-weight: 500;
}

QLabel#legendBadgeGreen {
    color: #ffffff; 
    background-color: #40a02b; 
    padding: 4px 10px; 
    border-radius: 12px;
    font-size: 11px;
    font-weight: 500;
}

QGroupBox {
    background-color: #e6e9ef;
    border: 1px solid #bcc0cc;
    border-radius: 8px;
    margin-top: 16px;
    padding: 16px;
    padding-top: 24px;
    font-size: 15px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    top: 4px;
    padding: 0 8px;
    color: #4c4f69;
    background-color: #e6e9ef;
}

/* ───────────────────────────────────────────────────────────────────────────
   TABS
   ─────────────────────────────────────────────────────────────────────────── */

QTabWidget::pane {
    border: none;
    background-color: #eff1f5;
    border-top: 1px solid #bcc0cc;
}

QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: #6c6f85;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 500;
    margin-right: 4px;
}

QTabBar::tab:selected {
    color: #8839ef;
    border-bottom: 3px solid #8839ef;
    background-color: transparent;
}

QTabBar::tab:hover:!selected {
    color: #4c4f69;
    background-color: #dce0e8;
    border-radius: 4px 4px 0 0;
}

/* ───────────────────────────────────────────────────────────────────────────
   INPUTS - Form fields
   ─────────────────────────────────────────────────────────────────────────── */

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 14px;
    min-height: 20px;
    selection-background-color: #1e66f5;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #8839ef;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #e6e9ef;
    color: #6c6f85;
}

QLineEdit::placeholder {
    color: #6c6f85;
}

/* ComboBox */
QComboBox {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 6px;
    padding: 6px 12px;
    padding-right: 36px;
    font-size: 14px;
    min-height: 20px;
}

QComboBox:focus {
    border: 1px solid #8839ef;
}

QComboBox:hover {
    border-color: #9ca0b0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
    background-color: transparent;
    margin-right: 4px;
}

QComboBox::down-arrow {
    image: url(chevron-down-dark.svg);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #4c4f69;
    border: 2px solid #8839ef;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #1e66f5;
    selection-color: #ffffff;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 4px;
    min-height: 28px;
    color: #4c4f69;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #dce0e8;
    color: #4c4f69;
}

/* SpinBox */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 14px;
    min-height: 20px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #8839ef;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #e6e9ef;
    border: none;
    width: 20px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #dce0e8;
}

/* DateEdit */
QDateEdit {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 6px;
    padding: 6px 12px;
    padding-right: 36px;
    font-size: 14px;
    min-height: 20px;
}

QDateEdit:focus {
    border: 1px solid #8839ef;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
    background-color: transparent;
    margin-right: 4px;
}

QDateEdit::down-arrow {
    image: url(chevron-down-dark.svg);
    width: 12px;
    height: 12px;
}

QDateEdit QAbstractItemView {
    background-color: #ffffff;
    color: #4c4f69;
    selection-background-color: #1e66f5;
    selection-color: #ffffff;
}

/* ───────────────────────────────────────────────────────────────────────────
   TABLES
   ─────────────────────────────────────────────────────────────────────────── */

QTableWidget, QTableView {
    background-color: #eff1f5;
    alternate-background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 8px;
    gridline-color: #bcc0cc;
    font-size: 13px;
    outline: none;
    selection-background-color: #1e66f5;
    selection-color: #ffffff;
}

QTableWidget::item, QTableView::item {
    padding: 12px 16px;
    border: none;
    border-bottom: 1px solid #bcc0cc;
    outline: none;
}

QTableWidget::item:hover, QTableView::item:hover {
    background-color: #dce0e8;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #1e66f5;
    color: #ffffff;
    border: none;
    outline: none;
}

QTableWidget::item:focus, QTableView::item:focus {
    border: none;
    outline: none;
}

QTableWidget:focus, QTableView:focus {
    border: 1px solid #8839ef;
    outline: none;
}

/* Table Header */
QHeaderView {
    background-color: #e6e9ef;
}

QHeaderView::section {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: none;
    border-bottom: 1px solid #bcc0cc;
    padding: 12px 16px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QHeaderView::section:horizontal {
    background-color: #e6e9ef;
}

QHeaderView::section:horizontal:hover {
    background-color: #dce0e8;
    color: #8839ef;
}

QHeaderView::section:vertical {
    background-color: #e6e9ef;
}

/* ───────────────────────────────────────────────────────────────────────────
   BUTTONS
   ─────────────────────────────────────────────────────────────────────────── */

QPushButton {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 500;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #dce0e8;
    border-color: #9ca0b0;
}

QPushButton:pressed {
    background-color: #ccd0da;
}

QPushButton:disabled {
    background-color: #e6e9ef;
    color: #9ca0b0;
    border-color: #bcc0cc;
}

/* Primary Button (Mauve) */
QPushButton[class="primary"], QPushButton#primaryButton {
    background-color: #8839ef;
    color: #ffffff;
    border: none;
    font-weight: 600;
}

QPushButton[class="primary"]:hover, QPushButton#primaryButton:hover {
    background-color: #9b5df0;
}

QPushButton[class="primary"]:pressed, QPushButton#primaryButton:pressed {
    background-color: #7528d9;
}

QPushButton[class="primary"]:disabled, QPushButton#primaryButton:disabled {
    background-color: #ccd0da;
    color: #9ca0b0;
}

/* Secondary Button */
QPushButton#secondaryButton {
    background-color: #dce0e8;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    font-weight: 500;
}

QPushButton#secondaryButton:hover {
    background-color: #ccd0da;
    border-color: #9ca0b0;
}

QPushButton#secondaryButton:pressed {
    background-color: #dce0e8;
}

QPushButton#secondaryButton:disabled {
    background-color: #e6e9ef;
    color: #9ca0b0;
    border-color: #bcc0cc;
}

/* Danger Button (Red outlined) */
QPushButton#dangerButton {
    background-color: #dce0e8;
    color: #d20f39;
    border: 1px solid #d20f39;
    font-weight: 500;
}

QPushButton#dangerButton:hover {
    background-color: #ccd0da;
}

QPushButton#dangerButton:pressed {
    background-color: #dce0e8;
}

QPushButton#dangerButton:disabled {
    background-color: #e6e9ef;
    color: #9ca0b0;
    border-color: #bcc0cc;
}

/* Success Button (Green) */
QPushButton[class="success"], QPushButton#successButton {
    background-color: #40a02b;
    color: #ffffff;
    border: none;
    font-weight: 600;
}

QPushButton[class="success"]:hover, QPushButton#successButton:hover {
    background-color: #4eb836;
}

QPushButton[class="success"]:disabled, QPushButton#successButton:disabled {
    background-color: #ccd0da;
    color: #9ca0b0;
}

/* Warning Button (Yellow) */
QPushButton#warningButton {
    background-color: #df8e1d;
    color: #ffffff;
    border: none;
    font-weight: 600;
}

QPushButton#warningButton:hover {
    background-color: #c98119;
}

QPushButton#warningButton:disabled {
    background-color: #ccd0da;
    color: #9ca0b0;
}

/* Danger Button (Red) */
QPushButton[class="danger"] {
    background-color: #d20f39;
    color: #ffffff;
    border: none;
    font-weight: 600;
}

QPushButton[class="danger"]:hover {
    background-color: #e32850;
}

/* Info Button (Blue) */
QPushButton[class="info"] {
    background-color: #1e66f5;
    color: #ffffff;
    border: none;
    font-weight: 600;
}

QPushButton[class="info"]:hover {
    background-color: #3578f6;
}

/* Warning Button (Yellow) */
QPushButton[class="warning"] {
    background-color: #df8e1d;
    color: #ffffff;
    border: none;
    font-weight: 600;
}

QPushButton[class="warning"]:hover {
    background-color: #e59e35;
}

/* ───────────────────────────────────────────────────────────────────────────
   LABELS
   ─────────────────────────────────────────────────────────────────────────── */

QLabel {
    font-size: 14px;
    background-color: transparent;
    color: #4c4f69;
}

QLabel[class="title"] {
    font-size: 20px;
    font-weight: 600;
    color: #4c4f69;
}

QLabel[class="section-header"] {
    font-size: 16px;
    font-weight: 600;
    color: #4c4f69;
}

QLabel[class="secondary"] {
    color: #6c6f85;
    font-size: 13px;
}

/* Badge styles */
QLabel[class="badge-active"] {
    background-color: #40a02b;
    color: #ffffff;
    border-radius: 999px;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 600;
}

QLabel[class="badge-inactive"] {
    background-color: #d20f39;
    color: #ffffff;
    border-radius: 999px;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 600;
}

QLabel[class="badge-info"] {
    background-color: #1e66f5;
    color: #ffffff;
    border-radius: 999px;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 600;
}

/* ───────────────────────────────────────────────────────────────────────────
   CHECKBOXES
   ─────────────────────────────────────────────────────────────────────────── */

QCheckBox {
    font-size: 14px;
    spacing: 8px;
    color: #4c4f69;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #bcc0cc;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #8839ef;
}

QCheckBox::indicator:checked {
    background-color: #8839ef;
    border-color: #8839ef;
}

/* ───────────────────────────────────────────────────────────────────────────
   RADIO BUTTONS
   ─────────────────────────────────────────────────────────────────────────── */

QRadioButton {
    font-size: 14px;
    spacing: 8px;
    color: #4c4f69;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #bcc0cc;
    border-radius: 9px;
    background-color: #ffffff;
}

QRadioButton::indicator:hover {
    border-color: #8839ef;
}

QRadioButton::indicator:checked {
    border-color: #8839ef;
    background-color: #8839ef;
}

/* ───────────────────────────────────────────────────────────────────────────
   SCROLLBARS
   ─────────────────────────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background-color: #e6e9ef;
    width: 10px;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #bcc0cc;
    border-radius: 5px;
    min-height: 40px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9ca0b0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #e6e9ef;
    height: 10px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #bcc0cc;
    border-radius: 5px;
    min-width: 40px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9ca0b0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ───────────────────────────────────────────────────────────────────────────
   DIALOGS
   ─────────────────────────────────────────────────────────────────────────── */

QDialog {
    background-color: #e6e9ef;
    color: #4c4f69;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* ───────────────────────────────────────────────────────────────────────────
   MESSAGE BOXES
   ─────────────────────────────────────────────────────────────────────────── */

QMessageBox {
    background-color: #e6e9ef;
}

QMessageBox QLabel {
    color: #4c4f69;
    font-size: 14px;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 8px 20px;
}

/* ───────────────────────────────────────────────────────────────────────────
   MENU BAR & MENUS
   ─────────────────────────────────────────────────────────────────────────── */

QMenuBar {
    background-color: #e6e9ef;
    color: #4c4f69;
    border-bottom: 1px solid #bcc0cc;
    padding: 4px 8px;
    font-size: 14px;
}

QMenuBar::item {
    padding: 8px 14px;
    border-radius: 4px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #dce0e8;
    color: #8839ef;
}

QMenu {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 8px;
    padding: 6px;
    font-size: 14px;
}

QMenu::item {
    padding: 10px 32px 10px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #dce0e8;
    color: #8839ef;
}

QMenu::separator {
    height: 1px;
    background-color: #bcc0cc;
    margin: 6px 12px;
}

/* ───────────────────────────────────────────────────────────────────────────
   TOOLTIPS
   ─────────────────────────────────────────────────────────────────────────── */

QToolTip {
    background-color: #4c4f69;
    color: #ffffff;
    border: 1px solid #6c6f85;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
}

/* ───────────────────────────────────────────────────────────────────────────
   STATUS BAR
   ─────────────────────────────────────────────────────────────────────────── */

QStatusBar {
    background-color: #e6e9ef;
    color: #6c6f85;
    border-top: 1px solid #bcc0cc;
    padding: 6px 16px;
    font-size: 13px;
}

/* ───────────────────────────────────────────────────────────────────────────
   CALENDAR WIDGET
   ─────────────────────────────────────────────────────────────────────────── */

QCalendarWidget {
    background-color: #e6e9ef;
    border: 1px solid #bcc0cc;
    border-radius: 8px;
}

QCalendarWidget QTableView {
    background-color: #ffffff;
    selection-background-color: #1e66f5;
    selection-color: #ffffff;
    font-size: 14px;
    alternate-background-color: #e6e9ef;
    outline: none;
}

QCalendarWidget QTableView::item {
    padding: 8px;
}

QCalendarWidget QTableView::item:hover {
    background-color: #dce0e8;
    border-radius: 4px;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #e6e9ef;
    border-bottom: 1px solid #bcc0cc;
    padding: 8px;
}

QCalendarWidget QToolButton {
    color: #4c4f69;
    background-color: transparent;
    border: 1px solid #bcc0cc;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 14px;
}

QCalendarWidget QToolButton:hover {
    background-color: #dce0e8;
    color: #8839ef;
}

QCalendarWidget QSpinBox {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 14px;
}

QCalendarWidget QMenu {
    background-color: #ffffff;
    color: #4c4f69;
}

QCalendarWidget #qt_calendar_monthbutton {
    min-width: 100px;
}

QCalendarWidget #qt_calendar_yearbutton {
    min-width: 60px;
}

/* ───────────────────────────────────────────────────────────────────────────
   PROGRESS BAR
   ─────────────────────────────────────────────────────────────────────────── */

QProgressBar {
    background-color: #dce0e8;
    border: none;
    border-radius: 4px;
    text-align: center;
    font-size: 12px;
    color: #6c6f85;
    height: 8px;
}

QProgressBar::chunk {
    background-color: #8839ef;
    border-radius: 4px;
}

/* ───────────────────────────────────────────────────────────────────────────
   INPUT DIALOG
   ─────────────────────────────────────────────────────────────────────────── */

QInputDialog {
    min-width: 400px;
}

/* ───────────────────────────────────────────────────────────────────────────
   SLIDER
   ─────────────────────────────────────────────────────────────────────────── */

QSlider::groove:horizontal {
    background-color: #dce0e8;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #8839ef;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #9b5df0;
}

QSlider::sub-page:horizontal {
    background-color: #8839ef;
    border-radius: 3px;
}

/* ───────────────────────────────────────────────────────────────────────────
   SPLITTER
   ─────────────────────────────────────────────────────────────────────────── */

QSplitter::handle {
    background-color: #bcc0cc;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #8839ef;
}

/* ───────────────────────────────────────────────────────────────────────────
   LIST WIDGET
   ─────────────────────────────────────────────────────────────────────────── */

QListWidget {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 8px 12px;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #dce0e8;
}

QListWidget::item:selected {
    background-color: #1e66f5;
    color: #ffffff;
}
